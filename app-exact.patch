+function waitForVideoEvent(video, eventNames, timeoutMs = 18000) {
+  const names = Array.isArray(eventNames) ? eventNames : [eventNames];
+  return new Promise((resolve, reject) => {
+    let timer = null;
+    const cleanup = () => {
+      if (timer) clearTimeout(timer);
+      names.forEach((name) => video.removeEventListener(name, handleSuccess));
+      video.removeEventListener("error", handleError);
+    };
+    const handleSuccess = () => {
+      cleanup();
+      resolve();
+    };
+    const handleError = () => {
+      cleanup();
+      reject(new Error("This video format could not be decoded for a thumbnail."));
+    };
+    names.forEach((name) => video.addEventListener(name, handleSuccess, { once: true }));
+    video.addEventListener("error", handleError, { once: true });
+    timer = setTimeout(() => {
+      cleanup();
+      reject(new Error("Video thumbnail generation timed out."));
+    }, timeoutMs);
+  });
+}
+
+async function generateVideoThumbnailFile(file) {
+  if (!(file instanceof File || file instanceof Blob)) throw new Error("Choose a valid video file.");
+  const objectUrl = URL.createObjectURL(file);
+  const video = document.createElement("video");
+  video.preload = "metadata";
+  video.muted = true;
+  video.playsInline = true;
+  video.setAttribute("playsinline", "");
+  video.src = objectUrl;
+
+  try {
+    video.load();
+    if (video.readyState < 1) await waitForVideoEvent(video, "loadedmetadata");
+    const duration = Number.isFinite(video.duration) ? video.duration : 0;
+    const target = duration > 0.4 ? Math.min(Math.max(duration * 0.08, 0.35), 2.5, Math.max(0.1, duration - 0.15)) : 0;
+    if (target > 0.05) {
+      video.currentTime = target;
+      await waitForVideoEvent(video, ["seeked", "loadeddata"]);
+    } else if (video.readyState < 2) {
+      await waitForVideoEvent(video, "loadeddata");
+    }
+
+    if (typeof video.requestVideoFrameCallback === "function") {
+      await new Promise((resolve) => video.requestVideoFrameCallback(() => resolve()));
+    }
+
+    const sourceWidth = Number(video.videoWidth || 0);
+    const sourceHeight = Number(video.videoHeight || 0);
+    if (!sourceWidth || !sourceHeight) throw new Error("The video has no readable frame.");
+    const maxWidth = 960;
+    const maxHeight = 720;
+    const scale = Math.min(1, maxWidth / sourceWidth, maxHeight / sourceHeight);
+    const canvas = document.createElement("canvas");
+    canvas.width = Math.max(1, Math.round(sourceWidth * scale));
+    canvas.height = Math.max(1, Math.round(sourceHeight * scale));
+    const context = canvas.getContext("2d", { alpha: false });
+    if (!context) throw new Error("The browser could not create a thumbnail canvas.");
+    context.fillStyle = "#2b1722";
+    context.fillRect(0, 0, canvas.width, canvas.height);
+    context.drawImage(video, 0, 0, canvas.width, canvas.height);
+    const blob = await canvasToBlob(canvas, "image/jpeg", 0.82);
+    if (!blob) throw new Error("The browser could not encode the video thumbnail.");
+    const baseName = String(file.name || "video").replace(/\.[^.]+$/, "").slice(0, 90) || "video";
+    return new File([blob], `${baseName}-thumbnail.jpg`, { type: "image/jpeg", lastModified: Date.now() });
+  } finally {
+    video.pause();
+    video.removeAttribute("src");
+    video.load();
+    URL.revokeObjectURL(objectUrl);
+  }
+}
+
+async function uploadVideoThumbnailToDrive(file, { itemId, album, onProgress = () => {} } = {}) {
+  try {
+    onProgress(3);
+    const thumbnailFile = await generateVideoThumbnailFile(file);
+    onProgress(30);
+    const logicalPath = `couples/${state.coupleId}/gallery/video-thumbnails/${album}/${itemId}-${randomId("thumb")}-${safeFileName(thumbnailFile.name)}`;
+    const uploaded = await uploadFileToDrive(thumbnailFile, logicalPath, (percent) => {
+      onProgress(30 + Math.round(percent * 0.7));
+    }, "gallery");
+    onProgress(100);
+    return uploaded;
+  } catch (error) {
+    console.warn("Video thumbnail generation skipped", file?.name, error);
+    return null;
+  }
+}
+
+function videoThumbnailStorageData(uploaded = null, existing = null) {
+  if (uploaded?.driveFileId) {
+    return {
+      thumbnailDriveFileId: uploaded.driveFileId,
+      thumbnailStoragePath: uploaded.path || "",
+      thumbnailContentType: uploaded.type || "image/jpeg",
+      thumbnailFileSize: Number(uploaded.size || 0)
+    };
+  }
+  if (existing?.thumbnailDriveFileId) {
+    return {
+      thumbnailDriveFileId: existing.thumbnailDriveFileId,
+      thumbnailStoragePath: existing.thumbnailStoragePath || "",
+      thumbnailContentType: existing.thumbnailContentType || "image/jpeg",
+      thumbnailFileSize: Number(existing.thumbnailFileSize || 0)
+    };
+  }
+  return {};
+}
